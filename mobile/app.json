{
  "expo": {
    "name": "KnightLoader",
    "slug": "knightloader-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.junkerderprovinz.knightloader"
    },
    "android": {
      "versionCode": 1,
      "package": "com.junkerderprovinz.knightloader",
      "adaptiveIcon": {
        "backgroundImage": "./assets/android-icon-background.png",
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "ndkVersion": "26.1.10909125",
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Zum Scannen des QR-Codes einer KnightLoader-Instanz."
        }
      ],
      "expo-localization"
    ]
  }
}
