{
  "maxConcurrent": 3,
  "maxPerHost": 2,
  "speedLimit": 0,
  "extract": true,
  "quiet": {
    "speedLimit": 0,
    "maxConcurrent": 1
  },
  "autoConfirm": false,
  "autoConfirmDelay": 0,
  "autoStart": true,
  "onDupes": "exclude",
  "onOffline": "exclude",
  "addAtTop": false,
  "downloadDir": "/data/downloads",
  "subfolderByPackage": true,
  "workDir": "",
  "archivePasswords": ["open-movies"],
  "extractTo": "",
  "extractSubfolder": false,
  "extractMoveTo": "",
  "extractCollision": "overwrite",
  "archiveDisposal": "trash",
  "trashRetentionDays": 14,
  "deleteInfoFiles": false,
  "maxRetries": 3,
  "retry": {
    "delay": 0,
    "max": 0,
    "byReason": {}
  },
  "stallTimeout": 120,
  "stallReconnect": true,
  "stallRestart": false,
  "stallMaxRestarts": 0,
  "diskReserve": 536870912,
  "diskLowSpace": 0,
  "diskCriticalSpace": 0,
  "volumeCap": 1500000000000,
  "volumeCapResetDay": 1,
  "volumeCapAction": "report",
  "volumeCapThrottle": 0,
  "crawl": true,
  "crawlDepth": 1,
  "crawlMaxPages": 20,
  "crawlSameHost": true,
  "crawlInclude": null,
  "crawlExclude": null,
  "watchDir": "/watch",
  "feeds": null,
  "verifyChecksums": true,
  "preParserEnabled": true,
  "downloadClientApi": false,
  "metrics": false,
  "shape": "soft",
  "accent": "",
  "rainbow": false,
  "rainbowReactive": false,
  "rainbowRotate": false,
  "rainbowSeed": 0,
  "rainbowPalette": null,
  "hideAccountsFromSidebar": false,
  "hideInstancesFromSidebar": false,
  "navLabels": "both",
  "bottomBarLabels": "follow",
  "autoUpdateCheck": false,
  "autoUpdateInstall": false,
  "ytdlpVersionCheck": false,
  "packagizer": {
    "rules": [
      {
        "name": "Open movies",
        "conditions": [
          {
            "field": "filename",
            "op": "matches",
            "value": "(?i)(big.?buck.?bunny|sintel|tears.?of.?steel|elephants.?dream)"
          },
          {
            "field": "filetype",
            "op": "matches",
            "value": "(?i)^(avi|divx|flv|m2ts|m4v|mkv|mov|mp4|mpeg|mpg|ogv|rmvb|ts|vob|webm|wmv)$"
          }
        ],
        "action": {
          "priority": 1,
          "category": "films"
        }
      },
      {
        "name": "Podcast episodes",
        "conditions": [
          {
            "field": "filetype",
            "op": "matches",
            "value": "(?i)^(aac|aiff|alac|ape|dsf|flac|m4a|mka|mp3|ogg|opus|wav|wma)$"
          },
          {
            "field": "url",
            "op": "contains",
            "value": "/episodes/"
          }
        ],
        "action": {
          "comment": "from <jd:hoster>",
          "category": "podcasts"
        }
      },
      {
        "name": "Linux images",
        "conditions": [
          {
            "field": "filename",
            "op": "matches",
            "value": "\\.iso$"
          }
        ],
        "action": {
          "chunks": 8,
          "category": "linux-images"
        }
      },
      {
        "name": "Big files last",
        "conditions": [
          {
            "field": "filesize",
            "op": "is-between",
            "min": 10737418240
          }
        ],
        "action": {
          "priority": -2
        }
      }
    ]
  },
  "linkFilter": {
    "rules": [
      {
        "name": "No samples",
        "conditions": [
          {
            "field": "filename",
            "op": "matches",
            "value": "(?i)[._-]sample[._-]"
          }
        ],
        "action": {
          "reject": true,
          "reason": "a sample, not the film"
        }
      }
    ]
  },
  "mirrorPolicy": "filename-and-size",
  "keepMirrors": false,
  "mirrorFailover": false,
  "collisionPolicy": "rename",
  "chunks": 0,
  "hostRules": {},
  "categories": [
    {
      "id": "films",
      "name": "Films",
      "dir": "/data/media/films",
      "priority": 1,
      "extract": true
    },
    {
      "id": "podcasts",
      "name": "Podcasts",
      "dir": "/data/media/podcasts",
      "priority": -1
    },
    {
      "id": "linux-images",
      "name": "Linux images",
      "dir": "/data/iso",
      "extract": false,
      "collision": "skip"
    }
  ],
  "mediaHooks": null,
