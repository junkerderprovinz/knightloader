# The self-hostable pairing relay (cmd/knightloader-relay). It has its own image
# because it needs none of the main image's tools and keeps no state, so there
# is no volume.

FROM golang:1.27-alpine@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
ARG VERSION=dev
# .dockerignore keeps .git out, so -version knows the commit only from here.
ARG COMMIT=
RUN CGO_ENABLED=0 go build \
      -ldflags="-s -w -X github.com/junkerderprovinz/knightloader/internal/buildinfo.Version=${VERSION} -X github.com/junkerderprovinz/knightloader/internal/buildinfo.Commit=${COMMIT}" \
      -o /out/knightloader-relay ./cmd/knightloader-relay

FROM alpine:3.24@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a
RUN apk add --no-cache ca-certificates && adduser -D -u 1000 relay
COPY --from=build /out/knightloader-relay /usr/local/bin/knightloader-relay

ENV KL_RELAY_ADDR=:8760
EXPOSE 8760

USER relay
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s \
  CMD wget -qO- http://127.0.0.1:8760/health >/dev/null 2>&1 || exit 1
ENTRYPOINT ["/usr/local/bin/knightloader-relay"]
