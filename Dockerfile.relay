# The self-hostable instance-pairing relay (cmd/knightloader-relay) - see
# docs/superpowers/specs/2026-08-25-self-hosted-relay-design.md. Deliberately
# its own image, not a mode of the main knightloader one: it carries none of
# the main binary's dependencies (no yt-dlp, no ffmpeg, no JRE), holds no
# state of its own beyond the current connection list (no VOLUME, nothing to
# back up), and is meant to be run by anyone who wants relay-based pairing
# for their own instances - not something KnightLoader operates on anyone's
# behalf.

FROM golang:1.27-alpine@sha256:4c9fe60190a2a3350ddc51de80d0224b8a6698d12bdfc999fee45ea9d6c46dbc AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
ARG VERSION=dev
RUN CGO_ENABLED=0 go build \
      -ldflags="-s -w -X github.com/junkerderprovinz/knightloader/internal/buildinfo.Version=${VERSION}" \
      -o /out/knightloader-relay ./cmd/knightloader-relay

FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b
RUN apk add --no-cache ca-certificates && adduser -D -u 1000 relay
COPY --from=build /out/knightloader-relay /usr/local/bin/knightloader-relay

ENV KL_RELAY_ADDR=:8760
EXPOSE 8760

USER relay
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s \
  CMD wget -qO- http://127.0.0.1:8760/health >/dev/null 2>&1 || exit 1
ENTRYPOINT ["/usr/local/bin/knightloader-relay"]
