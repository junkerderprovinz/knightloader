{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests",
    ":semanticCommits",
    ":dependencyDashboard",
    ":enableVulnerabilityAlertsWithLabel(security)"
  ],
  "timezone": "Europe/Vienna",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "prHourlyLimit": 4,
  "prConcurrentLimit": 6,
  "packageRules": [
    {
      "description": "GitHub Actions: auto-merge all updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major", "minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "commitMessagePrefix": "ci:",
      "labels": ["github-actions"]
    },
    {
      "description": "Go: group minor+patch module updates into one weekly PR; majors stay separate for review",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Go modules (non-major)",
      "commitMessagePrefix": "chore(deps):"
    },
    {
      "description": "npm (web UI): group minor+patch into one weekly PR; majors stay separate",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "web dependencies (non-major)",
      "commitMessagePrefix": "chore(deps):"
    },
    {
      "description": "The Expo SDK decides React, React Native and the native modules in mobile/; npx expo install --fix moves them with an SDK upgrade",
      "matchFileNames": ["mobile/package.json"],
      "matchPackageNames": ["expo", "expo-*", "@expo/**", "react", "react-dom", "@types/react", "react-native", "react-native-*", "@react-native/**", "@react-native-community/**"],
      "matchUpdateTypes": ["minor", "major"],
      "enabled": false
    },
    {
      "description": "Override for xcode, which loads uuid with require(); 12 and later are ESM only",
      "matchFileNames": ["mobile/package.json"],
      "matchPackageNames": ["uuid"],
      "allowedVersions": "<12"
    },
    {
      "description": "The desktop module points at the main module through a replace directive, so its version is never read",
      "matchFileNames": ["desktop/go.mod"],
      "matchPackageNames": ["github.com/junkerderprovinz/knightloader"],
      "enabled": false
    },
    {
      "description": "React Native's Android build expects JDK 17",
      "matchFileNames": [".github/workflows/release-mobile.yml"],
      "matchDepNames": ["java-jdk"],
      "allowedVersions": "17"
    }
  ]
}
